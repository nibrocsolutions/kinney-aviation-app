# Copy to .env for local runs. Docker Compose sets these itself.
DATA_DIR=./data
PORT=8088
# Load the sample Arizona fleet the first time the database is empty.
SEED_DEMO=1
# First-run sign-in. Leave the passwords blank with SEED_DEMO=0 to generate
# an administrator password in data/initial-admin-password.txt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Kinney-Admin-2026
SHOP_USERNAME=ron
SHOP_PASSWORD=Kinney-Shop-2026
# Set to 1 when the app is served over HTTPS.
SESSION_SECURE=0
